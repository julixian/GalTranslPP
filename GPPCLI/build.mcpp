import std;
import mcpp;
import mcpp.rules.qt;
import gpp.build;

int main() {
    return gpp::run_build_script([] {
        gpp::configure_executable_link_options();
        gpp::configure_vcpkg();
        auto qt_options = gpp::make_qt_options({"Core"});
        qt_options.i18n.qt_languages = {"zh_CN"}; // 程序加载的 translations/qt_zh_CN.qm。
        gpp::configure_translation(qt_options, "qt_gppcli_en.ts");
        if (!mcpp::rules::qt::compile(qt_options)) return 1;
        gpp::deploy_sample_project();
        gpp::provide_release_pack("GPPCLI", "GalTranslPP_CLI");
        return 0;
    });
}
