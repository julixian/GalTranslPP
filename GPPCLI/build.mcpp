import std;
import mcpp;
import gpp.rules.qt;
import gpp.build;

int main() {
    return gpp::run_build_script([] {
        gpp::win::configure_executable_link_options();
        const auto vcpkg_directory = gpp::win::configure_vcpkg("GalTranslPP_CLI");
        auto qt_options = gpp::win::make_qt_options({"Core"});
        const auto translation_file = gpp::win::configure_translation(qt_options, "qt_gppcli_en.ts");
        gpp::rules::qt::use(qt_options);
        gpp::win::release_publisher publisher("GalTranslPP_CLI", vcpkg_directory);
        publisher.publish_release("GPPCLI", translation_file);
        return 0;
    });
}
