import std;
import mcpp;
import gpp.rules.qt;
import gpp.build;

int main() {
    return gpp::run_build_script([] {
        gpp::win::configure_executable_link_options();
        const auto vcpkg_directory = gpp::win::configure_vcpkg("GalTranslPP_GUI");

        auto qt_options = gpp::win::make_qt_options({"Core", "Gui", "Network", "Widgets"});
        qt_options.resources = {"GPPGUI.qrc"};
        const auto translation_file = gpp::win::configure_translation(qt_options, "qt_gppgui_en.ts");
        gpp::rules::qt::use(qt_options);
        const auto ela_widget_tools = gpp::win::use_ela_widget_tools(qt_options);

        gpp::win::release_publisher publisher("GalTranslPP_GUI", vcpkg_directory);
        publisher.additional_runtime_directories.emplace_back(ela_widget_tools);
        publisher.publish_release("GPPGUI", translation_file);
        return 0;
    });
}
