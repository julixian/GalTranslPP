import std;
import mcpp;
import gpp.rules.qt;
import gpp.build;

int main() {
    if (std::string_view(mcpp::target_os()) == "macos") return gpp::macos::configure("GPPGUI");
    return gpp::runBuildScript([]()
        {
            gpp::win::configureExecutableLinkOptions();
            const auto vcpkgDirectory = gpp::win::configureVcpkg("GalTranslPP_GUI");

            auto qtOptions = gpp::win::makeQtOptions({"Core", "Gui", "Network", "Widgets"});
            qtOptions.resources = {"GPPGUI.qrc"};
            const auto translationFile = gpp::win::configureTranslation(qtOptions, "qt_gppgui_en.ts");
            gpp::rules::qt::use(qtOptions);
            const auto elaWidgetTools = gpp::win::useElaWidgetTools(qtOptions);

            gpp::win::ReleasePublisher publisher("GalTranslPP_GUI", vcpkgDirectory);
            publisher.additionalRuntimeDirectories.emplace_back(elaWidgetTools);
            publisher.publishRelease("GPPGUI", translationFile);
            return 0;
        });
}
