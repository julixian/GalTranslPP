import std;
import mcpp;
import mcpp.rules.qt;
import gpp.build;

int main() {
    return gpp::run_build_script([] {
        gpp::configure_executable_link_options();
        gpp::configure_vcpkg();

        auto qt_options = gpp::make_qt_options({"Core", "Gui", "Network", "Widgets"});
        qt_options.resources = {"GPPGUI.qrc"};
        qt_options.deploy_plugins = {"platforms", "styles", "imageformats"};
        qt_options.i18n.qt_languages = {"zh_CN"}; // 程序加载的 translations/qt_zh_CN.qm，Updater 共用。
        gpp::configure_translation(qt_options, "qt_gppgui_en.ts");
        if (!mcpp::rules::qt::compile(qt_options)) return 1;
        gpp::use_ela_widget_tools(qt_options);
        gpp::provide_release_pack("GPPGUI", "GalTranslPP_GUI");
        return 0;
    });
}
