import std;
import mcpp;
import gpp.rules.qt;
import gpp.build;

int main() {
    if (std::string_view(mcpp::target_os()) == "macos") return gpp::macos::configure("GalTranslPP");
    return gpp::runBuildScript([]()
        {
            gpp::win::configureVcpkg();
            gpp::win::linkPythonLibraries();
            auto qtOptions = gpp::win::makeQtOptions({"Core"});
            gpp::win::configureTranslation(qtOptions, "qt_gpp_en.ts");
            gpp::rules::qt::use(qtOptions);
            return 0;
        });
}
