import std;
import mcpp;
import gpp.rules.qt;
import gpp.build;

int main() {
    return gpp::run_build_script([] {
        gpp::configure_vcpkg();
        gpp::link_python_libraries();
        auto qt_options = gpp::make_qt_options({"Core"});
        gpp::configure_translation(qt_options, "qt_gpp_en.ts");
        if (!gpp::rules::qt::compile(qt_options)) return 1;
        return 0;
    });
}
