import std;
import mcpp;
import gpp.rules.qt;
import gpp.build;

int main() {
    if (std::string_view(mcpp::target_os()) == "macos") return gpp::macos::configure("Updater");
    return gpp::runBuildScript([]()
        {
            gpp::win::configureExecutableLinkOptions();
            const auto vcpkgDirectory = gpp::win::configureVcpkg("Updater");
            auto qtOptions = gpp::win::makeQtOptions({"Core"});
            const auto translationFile = gpp::win::configureTranslation(qtOptions, "qt_gppupdater_en.ts");
            gpp::rules::qt::use(qtOptions);
            gpp::win::ReleasePublisher publisher("Updater", vcpkgDirectory);
            publisher.publishRelease("Updater", translationFile);
            return 0;
        });
}
